# Copy this file to ".env.local" and fill in the value, then restart the dev server.
#
# Formspree powers contact-form delivery to booking@idj.events.
#   1. Create a free form at https://formspree.io (destination: booking@idj.events)
#   2. Copy the form ID — the part after "/f/" in the form's endpoint URL
#   3. Paste it below
#   4. On Vercel: Project → Settings → Environment Variables → add the same key/value, then redeploy
#
# Until this is set, the contact form falls back to opening the visitor's
# email app with their details pre-filled — so inquiries are never lost.

NEXT_PUBLIC_FORMSPREE_ID=your_form_id_here
